{
  "name": "ciervo-ui",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:demo": "vite build --config vite.config.demo.ts",
    "deploy": "npm run build:demo && gh-pages -d dist"
  },
  "files": [
    "dist"
  ],
  "main": "./dist/ciervo-ui.umd.js",
  "module": "./dist/ciervo-ui.es.js",
  "exports": {
    ".": {
      "import": "./dist/ciervo-ui.es.js",
      "require": "./dist/ciervo-ui.umd.js"
    },
    "./style.css": "./dist/style.css"
  },
  "peerDependencies": {
    "cuelume": ">=0.2.0",
    "vue": "^3.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.13.5",
    "@vitejs/plugin-vue": "^5.2.1",
    "@vue/tsconfig": "^0.7.0",
    "cuelume": "^0.2.2",
    "gh-pages": "^6.3.0",
    "typescript": "~5.7.2",
    "vite": "^6.1.1",
    "vue": "^3.5.13",
    "vue-tsc": "^2.2.4"
  }
}
